# Copy this file to .env and replace every placeholder before starting Agora.
AGORA_ENVIRONMENT=development
AGORA_TEST_DATABASE_RESET_ALLOWED=false
AGORA_DEBUG=true
AGORA_PORTAL_SECRET_KEY=GENERATE_LOCALLY
AGORA_CONTENT_SECRET_KEY=GENERATE_LOCALLY
AGORA_PORTAL_ORIGIN=http://localhost:8000
AGORA_CONTENT_ORIGIN=http://127.0.0.1:8001
ENV=PROD
TA_PROD_PASSWORD=SET_LOCALLY
AGORA_ARTIFACT_ROOT=SET_TO_ABSOLUTE_PATH
