# Run `uv run python scripts/bootstrap_env.py` to create .env safely.
# Placeholder values are intentionally rejected by runtime validation.
AGORA_ENVIRONMENT=development
AGORA_DEBUG=true
AGORA_PORTAL_SECRET_KEY=GENERATE_WITH_BOOTSTRAP
AGORA_CONTENT_SECRET_KEY=GENERATE_WITH_BOOTSTRAP
AGORA_PORTAL_ORIGIN=http://portal.agora.test:8000
AGORA_CONTENT_ORIGIN=http://content.agorausercontent.test:8001
ENV=PROD
TA_PROD_PASSWORD=SET_LOCALLY
AGORA_ARTIFACT_ROOT=SET_BY_BOOTSTRAP
